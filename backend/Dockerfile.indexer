FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY backend/ ./backend/
RUN dotnet restore backend/src/OpenPerps.Indexer/OpenPerps.Indexer.csproj
RUN dotnet publish backend/src/OpenPerps.Indexer/OpenPerps.Indexer.csproj -c Release -o /app/publish --no-restore
FROM mcr.microsoft.com/dotnet/runtime:8.0
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "OpenPerps.Indexer.dll"]
